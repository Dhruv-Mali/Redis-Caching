NODE_ENV=development
PORT=3000

# Local development with Docker Compose:
REDIS_URL=redis://localhost:6379

# Your existing MongoDB URI (keep the real value in .env, never commit it)
MONGODB_URI=mongodb://localhost:27017/myapp

# Optional public JSON API used by the example route
EXTERNAL_CATALOG_URL=https://jsonplaceholder.typicode.com/posts

# Cache policy
CACHE_TTL_SECONDS=900
CACHE_KEY_PREFIX=myapp
